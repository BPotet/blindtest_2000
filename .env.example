# Copie ce fichier en .env pour le développement local (facultatif : tout a un défaut).

# Port d'écoute du serveur (Render fournit sa propre valeur automatiquement).
PORT=3000

# Interface d'écoute.
HOST=0.0.0.0

# URL publique de base, utilisée pour générer l'URL encodée dans le QR code.
# En local, laisse vide : l'app la déduit de la requête.
# En production hors Render, mets par ex. https://blindtest.mondomaine.com
# (Sur Render, RENDER_EXTERNAL_URL est utilisé automatiquement.)
# PUBLIC_BASE_URL=
